{
  "name": "sponza-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Production Monorepo for Sponza Real-Time UPI Payment Platform",
  "scripts": {
    "dev": "powershell -ExecutionPolicy Bypass -File ./dev.ps1",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && python -m uvicorn app.main:app --reload --port 8000",
    "build:frontend": "cd frontend && npm run build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "keywords": [
    "sponza",
    "upi",
    "payments",
    "fastapi",
    "react",
    "monorepo"
  ]
}
