{
  "name": "sponsa-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Production Monorepo for Sponsa Real-Time UPI Payment Platform",
  "scripts": {
    "dev:landing": "cd landing && npm run dev",
    "dev:app": "cd frontend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && python -m uvicorn app.main:app --reload --port 8000",
    "build:landing": "cd landing && npm run build",
    "build:app": "cd frontend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "build:all": "npm run build:landing && npm run build:app",
    "heroku-postbuild": "cd frontend && npm install --include=dev && npm run build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "prepare": "husky || true"
  },
  "keywords": [
    "sponsa",
    "upi",
    "payments",
    "fastapi",
    "react",
    "monorepo"
  ],
  "lint-staged": {
    "frontend/src/**/*.{ts,tsx}": [
      "npm --prefix frontend run lint"
    ]
  },
  "devDependencies": {
    "husky": "^9.1.5",
    "lint-staged": "^15.2.10"
  }
}
